<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:ITDSWrapper.ViewModels.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:assets="clr-namespace:ITDSWrapper.Assets"
             mc:Ignorable="d" x:DataType="vm:ControllerDiagramViewModel"
             x:Class="ITDSWrapper.Views.Controls.ControllerDiagramView"
             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0 70 0 20" ColumnDefinitions="*" RowDefinitions="*">
        <Image Grid.Column="0" Grid.Row="0" 
               IsVisible="{Binding HasDiagram}" Source="{Binding DiagramImage}" 
               Stretch="Uniform" />
        <Label Grid.Column="0" Grid.Row="0" 
               IsVisible="{Binding !HasDiagram}" Classes="no-controller" 
               Content="{x:Static assets:Strings.NoControllerDetected}" />
    </Grid>
</UserControl>