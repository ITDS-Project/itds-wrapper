<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ITDSWrapper.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ITDSWrapper.Views"
        xmlns:assets="using:ITDSWrapper.Assets"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ITDSWrapper.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.png"
        WindowDecorations="{Binding Decorations}"
        ExtendClientAreaToDecorationsHint="{Binding ExtendClientArea}"
        WindowState="{Binding WindowState}"
        WindowStartupLocation="Manual"
        Title="{x:Static assets:Strings.GameTitle}">
        <views:MainView Name="View" />
</Window>
