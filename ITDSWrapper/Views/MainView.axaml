<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ITDSWrapper.ViewModels"
             xmlns:c="using:ITDSWrapper.Views.Controls"
             xmlns:g="using:ITDSWrapper.Graphics"
             xmlns:assets="using:ITDSWrapper.Assets"
             xmlns:mpv="using:HanumanInstitute.LibMpv.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ITDSWrapper.Views.MainView"
             x:DataType="vm:MainViewModel"
             SizeChanged="MainView_OnSizeChanged"
             TopLevel.AutoSafeAreaPadding="False"
             Name="View">
    
    <Grid RowDefinitions="Auto,*,Auto,Auto" PointerPressed="MainScreen_OnPointerPressed" 
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        
        <!-- <Image Grid.Row="0" Grid.RowSpan="4" Stretch="UniformToFill" Source="{Binding CurrentBorder}" -->
        <!--        Opacity="{Binding CurrentBorderOpacity}"/> -->
        <!-- <Image Grid.Row="0" Grid.RowSpan="4" Stretch="UniformToFill" Source="{Binding NextBorder}" -->
        <!--        Opacity="{Binding NextBorderOpacity}"/> -->
        <mpv:MpvView Grid.Row="0" Grid.RowSpan="4" Renderer="{Binding Renderer}" MpvContext="{Binding BorderMpvContexts[0]}"
                     Opacity="{Binding BorderOpacities[0]}" Width="{Binding BorderWidth}" Height="{Binding BorderHeight}" />
        <mpv:MpvView Grid.Row="0" Grid.RowSpan="4" Renderer="{Binding Renderer}" MpvContext="{Binding BorderMpvContexts[1]}"
                     Opacity="{Binding BorderOpacities[1]}" Width="{Binding BorderWidth}" Height="{Binding BorderHeight}"  />

        <Grid Row="0" Margin="0 0 23 0" MinHeight="{Binding TopPadding}" IsVisible="{Binding DisplayVirtualControls}">
            <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="*" ColumnDefinitions="*" Width="46" Height="46" HorizontalAlignment="Right">
                <Grid.Background>
                    <SvgResourceExtension Path="/Assets/VirtualButtons/MenuButton.svg" Stretch="Fill" AlignmentX="Center" AlignmentY="Center" />
                </Grid.Background>
                <c:VirtualButtonView Grid.Column="0" Grid.Row="0" Margin="0 10 0 0" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                     DataContext="{Binding MenuButton}" />
            </Grid>
        </Grid>
        
        <Grid Grid.Row="1" SizeChanged="ScreenGrid_OnSizeChanged">
            <g:EmuImage Name="DsScreen"
                   Source="{Binding CurrentFrame}"
                   Width="{Binding EmuRenderWidth}"
                   MaxHeight="{Binding EmuRenderHeight}"
                   PointerPressed="DsScreen_OnPointerPressed"
                   PointerReleased="DsScreen_OnPointerReleased"
                   PointerMoved="DsScreen_OnPointerMoved"
                   Effect="{Binding ScreenEffect}"/>
        </Grid>
        
        <Grid Grid.Row="2" Name="OnScreenControls" IsVisible="{Binding DisplayVirtualControls}"
              RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="5" Effect="{Binding ScreenEffect}">
            <Grid IsVisible="{Binding IsFullLayout}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" RowDefinitions="*" ColumnDefinitions="*,*,*,*" ColumnSpacing="14" HorizontalAlignment="Center">
                <Grid Grid.Column="0" VerticalAlignment="Center" Width="81" Height="45">
                    <Grid.Background>
                        <SvgResourceExtension Path="/Assets/VirtualButtons/LButton.svg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                    </Grid.Background>
                    <c:VirtualButtonView VerticalAlignment="Center" DataContext="{Binding LButton}" />
                </Grid>
                <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="81" Height="45">
                    <Grid.Background>
                        <SvgResourceExtension Path="/Assets/VirtualButtons/SelectButton.svg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                    </Grid.Background>
                    <c:VirtualButtonView HorizontalAlignment="Left" VerticalAlignment="Center" DataContext="{Binding SelectButton}" />
                </Grid>
                <Grid Grid.Column="2" VerticalAlignment="Center" Width="81" Height="45">
                    <Grid.Background>
                        <SvgResourceExtension Path="/Assets/VirtualButtons/StartButton.svg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                    </Grid.Background>
                    <c:VirtualButtonView HorizontalAlignment="Right" VerticalAlignment="Center" DataContext="{Binding StartButton}" />
                </Grid>
                <Grid  Grid.Column="3" VerticalAlignment="Center" Width="81" Height="45">
                    <Grid.Background>
                        <SvgResourceExtension Path="/Assets/VirtualButtons/RButton.svg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                    </Grid.Background>
                    <c:VirtualButtonView HorizontalAlignment="Right" VerticalAlignment="Center" DataContext="{Binding RButton}" />
                </Grid>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto" RowDefinitions="Auto" HorizontalAlignment="Center">
                <Grid.Background>
                    <SvgResourceExtension Path="/Assets/VirtualButtons/DPad.svg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Top" />
                </Grid.Background>
                <c:VirtualDPadView DataContext="{Binding Dpad}" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center">
                <Grid.Background>
                    <SvgResourceExtension Path="/Assets/VirtualButtons/FaceButtons.svg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Top" />
                </Grid.Background>
                <c:VirtualButtonView Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" DataContext="{Binding XButton}" />
                <c:VirtualButtonView Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" DataContext="{Binding YButton}" />
                <c:VirtualButtonView Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" DataContext="{Binding AButton}" />
                <c:VirtualButtonView Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" DataContext="{Binding BButton}" />
            </Grid>
            <Grid IsVisible="{Binding !IsFullLayout}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" RowDefinitions="*" ColumnDefinitions="*" HorizontalAlignment="Center">
                <Grid VerticalAlignment="Center" Width="81" Height="42">
                    <Grid.Background>
                        <SvgResourceExtension Path="/Assets/VirtualButtons/StartButton.svg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                    </Grid.Background>
                    <c:VirtualButtonView HorizontalAlignment="Right" VerticalAlignment="Center" DataContext="{Binding StartButton}" />
                </Grid>
            </Grid>
        </Grid>
        
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Classes="overlaydimming" 
                IsVisible="{Binding DisplayMenuOverlay}" />
        
        <StackPanel Grid.Row="3" MinHeight="{Binding BottomPadding}"/>
        
        <Grid Grid.Row="0" Grid.RowSpan="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Name="SettingsOverlay" 
              IsVisible="{Binding DisplayMenuOverlay}" Classes="overlaymenucontainer"
              RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="Auto,*" XYFocus.NavigationModes="Enabled"
              XYFocus.UpNavigationStrategy="Projection"
              XYFocus.DownNavigationStrategy="Projection"
              XYFocus.LeftNavigationStrategy="Projection"
              XYFocus.RightNavigationStrategy="Projection">
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" MinHeight="{Binding TopPadding}"/>
            <Grid Grid.Row="1" IsVisible="{Binding ShowSidebar}" Grid.Column="0" Classes="menu" RowDefinitions="Auto,*,Auto">
                <ScrollViewer Classes="menucontainerscroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Classes="menucontainer" Grid.Row="1">
                        <Label Classes="header" Content="{x:Static assets:Strings.Menu}" />
                        <Button Classes="menuitem" x:Name="FirstMenuItem"
                                Command="{Binding CloseMenuOverlayCommand}"
                                Content="{x:Static assets:Strings.SettingsBackToGame}"
                                XYFocus.Up="{Binding #LastMenuItem}" />
                        <Button Classes="menuitem"
                                Command="{Binding OpenDisplaySettingsMenuCommand}"
                                Content="{x:Static assets:Strings.SystemSettings}" />
                        <Button Classes="menuitem"
                                Command="{Binding OpenControllerSettingsMenuCommand}"
                                Content="{x:Static assets:Strings.SettingsController}" />
                        <Button Classes="menuitem"
                                Command="{Binding OpenLegalMenuCommand}"
                                Content="{x:Static assets:Strings.SettingsLegal}" />
                        <Button Classes="menuitem"
                                Command="{Binding OpenFeedbackCommand}"
                                Content="{x:Static assets:Strings.SettingsFeedback}" />
                        <Button Classes="menuitem"
                                Command="{Binding OpenDiscordUrlCommand}"
                                Content="{x:Static assets:Strings.SettingsDiscord}" />
                        <Button Classes="menuitem" x:Name="LastMenuItem"
                                Command="{Binding QuitToDesktopCommand}"
                                IsVisible="{Binding !IsMobile}"
                                Content="{x:Static assets:Strings.SettingsQuitToDesktop}"
                                XYFocus.Down="{Binding #FirstMenuItem}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" Classes="submenu"
                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="SystemSettingsMenuOpen" />
                        <Binding Path="ControllerSettingsMenuOpen" />
                        <Binding Path="KeyBindingsSettingsMenuOpen" />
                        <Binding Path="LegalMenuOpen" />
                        <Binding Path="FeedbackModalOpen" />
                    </MultiBinding>
                </Grid.IsVisible>
                <Grid IsVisible="{Binding SystemSettingsMenuOpen}" Classes="submenucontainer" RowDefinitions="Auto,*,Auto,Auto"
                      RowSpacing="5" ColumnSpacing="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Label Grid.Row="0" Classes="header" Content="{x:Static assets:Strings.SettingsSystemHeader}" />
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Classes="settingsgrid">
                        <Label Grid.Row="0" Grid.Column="0" Classes="setting" Content="{x:Static assets:Strings.WindowStateSettingsLabel}" IsVisible="{Binding !IsMobile}"/>
                        <Button Grid.Row="0" Grid.Column="1" Classes="setting-button" Content="◁" Command="{Binding ChangeWindowingSettingsCommand}"
                                CommandParameter="{x:False}" IsVisible="{Binding !IsMobile}"/>
                        <Label Grid.Row="0" Grid.Column="2" Classes="setting-value" Content="{Binding WindowingModeDesc}" IsVisible="{Binding !IsMobile}"/>
                        <Button Grid.Row="0" Grid.Column="3" Classes="setting-button" Content="▷" Command="{Binding ChangeWindowingSettingsCommand}"
                                CommandParameter="{x:True}" IsVisible="{Binding !IsMobile}"/>
                        <Rectangle Grid.Row="0" Grid.Column="0" Classes="divider" />

                        <Label Grid.Row="1" Grid.Column="0" Classes="setting" Content="{x:Static assets:Strings.SettingsFullScreenMonitor}" IsVisible="{Binding !IsMobile}"/>
                        <Button Grid.Row="1" Grid.Column="1" Classes="setting-button" Content="◁" Command="{Binding ChangeCurrentMonitorCommand}"
                                CommandParameter="{x:False}" IsVisible="{Binding !IsMobile}"/>
                        <Label Grid.Row="1" Grid.Column="2" Classes="setting-value" Content="{Binding CurrentMonitor}" IsVisible="{Binding !IsMobile}"/>
                        <Button Grid.Row="1" Grid.Column="3" Classes="setting-button" Content="▷" Command="{Binding ChangeCurrentMonitorCommand}"
                                CommandParameter="{x:True}" IsVisible="{Binding !IsMobile}"/>
                        <Rectangle Grid.Row="1" Grid.Column="0" Classes="divider" />
                        
                        <Label Grid.Row="2" Grid.Column="0" Classes="setting" Content="{x:Static assets:Strings.SettingsScreenLayout}" IsVisible="{Binding !IsMobile}"/>
                        <Button Grid.Row="2" Grid.Column="1" Classes="setting-button" Content="◁" Command="{Binding ChangeScreenLayoutCommand}"
                                CommandParameter="{x:False}" IsVisible="{Binding !IsMobile}" IsEnabled="{Binding !TargetScreenLayoutLocked}"/>
                        <Label Grid.Row="2" Grid.Column="2" Classes="setting-value" Content="{Binding TargetScreenLayoutDesc}" IsVisible="{Binding !IsMobile}"
                               IsEnabled="{Binding !TargetScreenLayoutLocked}"/>
                        <Button Grid.Row="2" Grid.Column="3" Classes="setting-button" Content="▷" Command="{Binding ChangeScreenLayoutCommand}"
                                CommandParameter="{x:True}" IsVisible="{Binding !IsMobile}" IsEnabled="{Binding !TargetScreenLayoutLocked}"/>
                        <Rectangle Grid.Row="2" Grid.Column="0" Classes="divider" />
                        
                        <Label Grid.Row="3" Grid.Column="0" Classes="setting" Content="{x:Static assets:Strings.SettingsBorders}"/>
                        <Button Grid.Row="3" Grid.Column="1" Classes="setting-button" Content="◁" Command="{Binding ChangeBorderSettingsCommand}"/>
                        <Label Grid.Row="3" Grid.Column="2" Classes="setting-value" Content="{Binding BordersSettingDesc}"/>
                        <Button Grid.Row="3" Grid.Column="3" Classes="setting-button" Content="▷" Command="{Binding ChangeBorderSettingsCommand}"/>
                        <Rectangle Grid.Row="3" Grid.Column="0" Classes="divider" />
                        
                        <Label IsVisible="{OnPlatform 'False', Linux='True'}" Grid.Row="4" Grid.Column="0" Classes="setting" Content="{x:Static assets:Strings.SettingsGraphicsBackend}"/>
                        <Button IsVisible="{OnPlatform 'False', Linux='True'}" Grid.Row="4" Grid.Column="1" Classes="setting-button" Content="◁"
                                Command="{Binding ChangeRenderingModeCommand}" CommandParameter="{x:False}"/>
                        <Label IsVisible="{OnPlatform 'False', Linux='True'}" Grid.Row="4" Grid.Column="2" Classes="setting-value" Content="{Binding LinuxRenderingModeDesc}"/>
                        <!-- <Label IsVisible="{OnPlatform 'False', macOS='True'}" Grid.Row="4" Grid.Column="2" Classes="setting-value" Content="{Binding MacOsRenderingModeDesc}"/> -->
                        <!-- <Label IsVisible="{OnPlatform 'False', Windows='True'}" Grid.Row="4" Grid.Column="2" Classes="setting-value" Content="{Binding WindowsRenderingModeDesc}"/> -->
                        <Button IsVisible="{OnPlatform 'False', Linux='True'}" Grid.Row="4" Grid.Column="3" Classes="setting-button" Content="▷"
                                Command="{Binding ChangeRenderingModeCommand}" CommandParameter="{x:True}"/>
                        <Rectangle Grid.Row="4" Grid.Column="0" Classes="divider" />
                        
                        <Label IsVisible="{Binding CanSelectAudioDevice}" Grid.Row="5" Grid.Column="0" Classes="setting" Content="{x:Static assets:Strings.SettingsAudioDevice}"/>
                        <Button IsVisible="{Binding CanSelectAudioDevice}" Grid.Row="5" Grid.Column="1" Classes="setting-button" Content="◁"
                                Command="{Binding ChangeAudioDeviceSettingsCommand}" CommandParameter="{x:False}"/>
                        <Label IsVisible="{Binding CanSelectAudioDevice}" Grid.Row="5" Grid.Column="2" Classes="setting-value" Content="{Binding CurrentAudioDevice}"/>
                        <Button IsVisible="{Binding CanSelectAudioDevice}" Grid.Row="5" Grid.Column="3" Classes="setting-button" Content="▷"
                                Command="{Binding ChangeAudioDeviceSettingsCommand}" CommandParameter="{x:True}"/>
                        <Rectangle Grid.Row="5" Grid.Column="0" Classes="divider" />
                        
                        <Label Grid.Row="6" Grid.Column="0" Classes="setting" Content="{x:Static assets:Strings.SettingsScreenReader}"/>
                        <Button Grid.Row="6" Grid.Column="1" Classes="setting-button" Content="◁" Command="{Binding ChangeScreenReaderSettingsCommand}"/>
                        <Label Grid.Row="6" Grid.Column="2" Classes="setting-value" Content="{Binding ScreenReaderSettingDesc}"/>
                        <Button Grid.Row="6" Grid.Column="3" Classes="setting-button" Content="▷" Command="{Binding ChangeScreenReaderSettingsCommand}"/>
                        
                        <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" Classes="menuitem"  IsVisible="{Binding IsMobile}"
                                Command="{Binding SettingsBackCommand}"
                                Content="{x:Static assets:Strings.SettingsBack}" />
                    </Grid>
                </Grid>
                <Grid IsVisible="{Binding ControllerSettingsMenuOpen}" Classes="submenucontainer" RowDefinitions="Auto,*"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Label Grid.Row="0" Classes="header" Content="{x:Static assets:Strings.SettingsControllerHeader}" />
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,Auto" Classes="settingsgrid"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsVisible="{Binding IsMobile}">
                        <Label Grid.Row="0" Grid.Column="0" Classes="setting" Content="{x:Static assets:Strings.SettingsVirtualButtonLayout}"/>
                        <Button Grid.Row="0" Grid.Column="1" Classes="setting" Content="◁" Command="{Binding ChangeVirtualButtonsLayoutSettingsCommand}"/>
                        <Label Grid.Row="0" Grid.Column="2" Classes="setting-value" Content="{Binding VirtualButtonsLayoutSettingDesc}"/>
                        <Button Grid.Row="0" Grid.Column="3" Classes="setting" Content="▷" Command="{Binding ChangeVirtualButtonsLayoutSettingsCommand}"/>
                        <Rectangle Grid.Row="0" Grid.Column="0" Classes="divider" />
                        
                        <Label Grid.Row="1" Grid.Column="0" Classes="setting" Content="{x:Static assets:Strings.SettingsControlPadHaptics}"/>
                        <Button Grid.Row="1" Grid.Column="1" Classes="setting" Content="◁" Command="{Binding ChangeControlPadHapticsSettingsCommand}"/>
                        <Label Grid.Row="1" Grid.Column="2" Classes="setting-value" Content="{Binding VirtualButtonsHapticsSettingDesc}"/>
                        <Button Grid.Row="1" Grid.Column="3" Classes="setting" Content="▷" Command="{Binding ChangeControlPadHapticsSettingsCommand}"/>
                        <Rectangle Grid.Row="1" Grid.Column="0" Classes="divider" />
                        
                        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Classes="menuitem"
                                Command="{Binding SettingsBackCommand}"
                                Content="{x:Static assets:Strings.SettingsBack}" />
                    </Grid>
                    <Grid Margin="10 0 0 0" Grid.Row="1" RowDefinitions="*,Auto,Auto" 
                          ColumnDefinitions="*" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Classes="settingsgrid">
                        <c:ControllerDiagramView Grid.Row="0" Grid.Column="0"  DataContext="{Binding ControllerDiagram}" />
                        <Rectangle Grid.Row="1" Grid.Column="0" Classes="divider" />
                        <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center" Margin="0 40" ColumnSpacing="30">
                            <Button Grid.Row="0" Grid.Column="0" Classes="primary-button"
                                    Content="{x:Static assets:Strings.ModifyControlBindings}" 
                                    Command="{Binding OpenKeyBindingsCommand}" />
                        </Grid>
                    </Grid>
                </Grid>
                <Grid IsVisible="{Binding KeyBindingsSettingsMenuOpen}" Classes="submenucontainer" RowDefinitions="Auto,*,Auto,Auto"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Label Grid.Row="0" Classes="header" Content="{x:Static assets:Strings.SettingsKeyBindingsHeader}" />
                    <Grid Margin="10 0 0 0" Grid.Row="1" RowDefinitions="*,Auto,Auto" ColumnDefinitions="*"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Classes="settingsgrid">
                        <HeaderedItemsControl Grid.Row="0" Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding InputBindings}">
                            <HeaderedItemsControl.Header>
                                <Grid ColumnDefinitions="*,Auto,Auto" Classes="settingsgrid">
                                    <Label Grid.Column="0" Classes="binding" Content="{x:Static assets:Strings.KeyBindingsActionHeader}" />
                                    <Label Grid.Column="1" Classes="binding"
                                            Content="{x:Static assets:Strings.KeyBindingsKeyHeader}"/>
                                    <Label Grid.Column="2" Classes="binding"
                                            Content="{x:Static assets:Strings.KeyBindingsButtonHeader}" />
                                </Grid>
                            </HeaderedItemsControl.Header>
                            <HeaderedItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto" Classes="settingsgrid">
                                        <Label Grid.Column="0" Classes="binding" Content="{Binding ActionDescription}" />
                                        <Button Grid.Column="1" Classes="binding-value"
                                                Content="{Binding KeyDescription}"
                                                Command="{Binding #View.((vm:MainViewModel)DataContext)?.RecordControllerBindingCommand}"
                                                CommandParameter="{Binding $self}" Tag="Keyboard" />
                                        <Button Grid.Column="2" Classes="binding-value"
                                                Content="{Binding ButtonDescription}"
                                                Command="{Binding #View.((vm:MainViewModel)DataContext)?.RecordControllerBindingCommand}"
                                                CommandParameter="{Binding $self}" Tag="Controller" />
                                    </Grid>
                                </DataTemplate>
                            </HeaderedItemsControl.ItemTemplate>
                        </HeaderedItemsControl>
                        <Rectangle Grid.Row="1" Grid.Column="0" Classes="divider"  />
                        <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center" Margin="0 40" ColumnSpacing="30">
                            <Button Grid.Row="0" Grid.Column="0" Classes="primary-button"
                                    Content="{x:Static assets:Strings.ResetButton}" />
                            <Button Grid.Row="0" Grid.Column="1" Classes="primary-button"
                                    Command="{Binding OpenControllerSettingsMenuCommand}"
                                    Content="{x:Static assets:Strings.DoneButton}" />
                        </Grid>
                    </Grid>
                </Grid>
                <Grid IsVisible="{Binding LegalMenuOpen}" Classes="submenucontainer" RowDefinitions="Auto,*,Auto"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Label Grid.Row="0" Classes="header" Content="{x:Static assets:Strings.SettingsLegal}" />
                    <Grid Grid.Row="1" RowDefinitions="Auto" ColumnDefinitions="Auto,Auto,Auto,Auto"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Classes="menuitem"  IsVisible="{Binding IsMobile}"
                                Command="{Binding SettingsBackCommand}"
                                Content="{x:Static assets:Strings.SettingsBack}" />
                    </Grid>
                </Grid>
                <Grid IsVisible="{Binding FeedbackModalOpen}" Classes="submenucontainer"
                      RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Button Grid.Row="0" Grid.Column="0" Classes="feedback" Content="👍" Command="{Binding PositiveFeedbackCommand}" CommandParameter="{Binding #FeedbackCommentBox}"/>
                    <Button Grid.Row="0" Grid.Column="1" Classes="feedback" Content="👎" Command="{Binding NegativeFeedbackCommand}" CommandParameter="{Binding #FeedbackCommentBox}"/>
                    <Button Grid.Row="0" Grid.Column="2" Classes="feedback" Content="❗" Command="{Binding ProblemFeedbackCommand}" CommandParameter="{Binding #FeedbackCommentBox}"/>
                    <TextBox x:Name="FeedbackCommentBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" PlaceholderText="Comment Here"/>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" MinHeight="{Binding BottomPadding}"/>
        </Grid>
    </Grid>
</UserControl>